{
  "name": "@pharmapms/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check src tests *.ts *.js .prettierrc",
    "db:generate": "prisma generate --schema ../database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ../database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema ../database/prisma/schema.prisma",
    "db:validate": "prisma validate --schema ../database/prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^11.0.0",
    "@fastify/sensible": "^6.0.3",
    "@prisma/client": "^6.16.2",
        "argon2": "^0.41.1",
    "dotenv": "^17.2.2",
    "fastify": "^5.5.0",
    "pino": "^9.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
        "@types/node": "^24.5.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "tsx": "^4.19.1",
        "typescript-eslint": "^8.43.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
